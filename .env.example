# Development environment for docker-compose. No real secrets here.
POSTGRES_USER=phlo
POSTGRES_PASSWORD=phlo
POSTGRES_DB=phlo_observer

# phlo-observer
PHLO_OBSERVER_HOST=0.0.0.0
PHLO_OBSERVER_PORT=8080
PHLO_OBSERVER_DATABASE_URL=postgresql+asyncpg://phlo:phlo@postgres:5432/phlo_observer
PHLO_OBSERVER_INGEST_TOKENS=dev-ingest-token
PHLO_OBSERVER_READ_TOKENS=dev-read-token
PHLO_OBSERVER_RAW_RETENTION_DAYS=14
PHLO_OBSERVER_EVENT_RETENTION_DAYS=90
PHLO_OBSERVER_RUN_RETENTION_DAYS=365
PHLO_OBSERVER_MAX_BODY_BYTES=10485760
PHLO_OBSERVER_MAX_BATCH_EVENTS=1000
PHLO_OBSERVER_OTLP_ENDPOINT=
PHLO_OBSERVER_LOG_LEVEL=INFO
PHLO_OBSERVER_METRICS_ENABLED=true
# Any secret above also supports a _FILE variant, e.g.
# PHLO_OBSERVER_INGEST_TOKENS_FILE=/run/secrets/ingest_tokens

# observe-core client defaults (consumed by instrumented apps)
OBSERVE_HTTP_ENDPOINT=http://localhost:8080/v1/events
OBSERVE_HTTP_API_KEY=dev-ingest-token
